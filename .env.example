# ═══════════════════════════════════════════════════════════════
# iMestreDigital — Variáveis de Ambiente (TEMPLATE)
# ═══════════════════════════════════════════════════════════════
# Este arquivo lista TODAS as variáveis exigidas pela stack de produção
# (infra/docker/docker-compose.prod.yml) e pelo script de deploy
# (infra/docker/deploy.sh).
#
# Uso em produção (na VPS):
#   cp .env.example infra/docker/.env.production
#   nano infra/docker/.env.production   # preencha os valores reais
#   cd infra/docker && ./deploy.sh deploy
#
# Uso em desenvolvimento local (mock, sem microserviços):
#   O frontend roda 100% em mock — não precisa deste arquivo.
#   Para subir a infra local (Postgres/Redis/Redpanda) use:
#   npm run docker:up   (infra/docker/docker-compose.dev.yml — sem senhas)
#
# ⚠️  NUNCA faça commit do arquivo .env / .env.production preenchido.
# ⚠️  Gere segredos fortes:  openssl rand -base64 48
# ═══════════════════════════════════════════════════════════════

# ─── Geral ─────────────────────────────────────────────────
# Ambiente Node — em produção DEVE ser "production" (ativa o fail-fast de JWT).
NODE_ENV=production
# Tag da imagem Docker construída (imestredigital/<serviço>:${APP_VERSION}).
APP_VERSION=latest
# Domínio público (usado pelo Nginx e pelo Grafana root URL).
DOMAIN=seudominio.com.br

# ─── URLs públicas do Frontend (Next.js) ───────────────────
# Injetadas no build/runtime do serviço `web`. Deixe vazio para usar caminhos relativos.
NEXT_PUBLIC_API_URL=https://seudominio.com.br/api
NEXT_PUBLIC_APP_URL=https://seudominio.com.br

# ─── PostgreSQL ────────────────────────────────────────────
# Um banco por microserviço é criado automaticamente por infra/docker/init-db.sql.
POSTGRES_USER=imestredigital
# OBRIGATÓRIO (o compose falha se ausente). Use senha forte.
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
# Database principal (compartilhado). Os demais têm nome fixo (auth_service, etc.).
POSTGRES_DB=imestredigital

# ─── Redis (cache) ─────────────────────────────────────────
# OBRIGATÓRIO (o compose falha se ausente). Use senha forte.
# Evite os caracteres / e = na senha (quebram parsing de REDIS_URL em alguns clients).
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE

# ─── JWT (autenticação — compartilhado por TODOS os serviços) ──
# OBRIGATÓRIO. É a MESMA chave em todos os 10 serviços: o auth-service assina
# os tokens e cada serviço verifica a assinatura no TenantMiddleware.
# Gere com: openssl rand -base64 64
JWT_SECRET=TROQUE_POR_CHAVE_SUPER_SECRETA_64_CHARS
# OBRIGATÓRIO apenas para o auth-service (assina os refresh tokens).
# Gere uma chave DIFERENTE da JWT_SECRET.
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_CHAVE_SUPER_SECRETA_64_CHARS

# ─── IA / LLM (ai-service — opcional) ──────────────────────
# Deixe vazio se não usar o módulo iMestreAI. Ao menos um provider é
# necessário para as features de IA funcionarem.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Marketplaces / Mercado Livre (marketplace-service) ────
# Credenciais da aplicação Mercado Livre (painel de desenvolvedores).
# Necessárias para o OAuth por tenant e a integração de pedidos/anúncios.
# ML_REDIRECT_URI DEVE ser HTTPS em produção e igual à URI cadastrada no painel.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://seudominio.com.br/api/v1/contas/mercadolivre/callback
# Criptografia AES-256-GCM dos tokens de marketplace em repouso.
# OBRIGATÓRIO em produção. Gere com: openssl rand -hex 32
MARKETPLACE_CRYPTO_KEY=TROQUE_POR_CHAVE_HEX_32_BYTES

# ─── Email / SMTP (notification-service — opcional) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── SSL / Let's Encrypt (deploy.sh ssl) ───────────────────
# Email usado no registro do certificado ACME.
CERTBOT_EMAIL=seu@email.com

# ─── Observabilidade (perfil "observability" — opcional) ───
# Senha do admin do Grafana. Ativado com: docker compose --profile observability up -d
GRAFANA_PASSWORD=troque-esta-senha

# ─── Storage S3 / MinIO (perfil "storage" — opcional) ──────
MINIO_USER=minioadmin
MINIO_PASSWORD=TROQUE_POR_SENHA_FORTE
