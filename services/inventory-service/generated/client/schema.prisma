// ═══════════════════════════════════════════════════════════════
// iMestreDigital - Schema do Inventory Service
// ═══════════════════════════════════════════════════════════════
// Gerencia estoque multi-depósito, reservas e movimentações.
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enumerações ──────────────────────────────────────────────

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
  TRANSFERENCIA
  DEVOLUCAO
  RESERVA
}

enum MotivoMovimentacao {
  COMPRA
  VENDA
  AJUSTE_INVENTARIO
  TRANSFERENCIA_DEPOSITO
  DEVOLUCAO_CLIENTE
  DEVOLUCAO_FORNECEDOR
  DEVOLUCAO
  PERDA
  AVARIA
  CONSUMO
  PRODUCAO
  OUTRO
}

enum StatusReserva {
  ATIVA
  CONFIRMADA
  CANCELADA
  EXPIRADA
}

/// Depósito / armazém / centro de distribuição
model Deposito {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  nome     String
  endereco String?
  cidade   String?
  estado   String?
  padrao   Boolean @default(false) // Depósito padrão do tenant
  ativo    Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  saldos        SaldoEstoque[]
  movimentacoes Movimentacao[]

  @@index([tenantId])
  @@map("depositos")
}

/// Saldo de estoque de um produto em um depósito específico
model SaldoEstoque {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  produtoId  String   @map("produto_id") @db.Uuid
  depositoId String   @map("deposito_id") @db.Uuid
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  quantidadeFisica Int @default(0) @map("quantidade_fisica") // Quantidade real no depósito
  reservado        Int @default(0) // Quantidade reservada para pedidos
  estoqueMinimo    Int @default(0) @map("estoque_minimo") // Ponto de pedido

  lote        String? // Número do lote
  numeroSerie String? @map("numero_serie") // Número de série

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Disponível = quantidadeFisica - reservado (calculado no service)

  @@unique([tenantId, produtoId, depositoId], name: "tenantId_produtoId_depositoId")
  @@index([tenantId])
  @@index([tenantId, produtoId])
  @@map("saldos_estoque")
}

/// Reserva de estoque para um pedido (impede venda duplicada)
model ReservaEstoque {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  produtoId  String        @map("produto_id") @db.Uuid
  /// Depósito de onde o estoque foi reservado. Nulo apenas em reservas
  /// legadas criadas antes da reserva passar a ser por depósito.
  depositoId String?       @map("deposito_id") @db.Uuid
  pedidoId   String        @map("pedido_id") @db.Uuid
  quantidade Int
  status     StatusReserva @default(ATIVA)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([tenantId, pedidoId])
  @@index([tenantId, produtoId])
  @@map("reservas_estoque")
}

/// Registro de eventos já processados (idempotência do consumo Kafka).
/// Garante que o mesmo evento (ex. pedido.pago para um pedidoId) só produza
/// efeito colateral uma única vez, mesmo com reentrega do broker.
model EventoProcessado {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  /// Nome lógico do evento consumido (ex. "pedido.criado", "pedido.pago").
  evento       String
  /// Identificador do agregado de referência (ex. pedidoId).
  referenciaId String @map("referencia_id")

  processadoEm DateTime @default(now()) @map("processado_em")

  @@unique([evento, referenciaId], name: "evento_referenciaId")
  @@index([tenantId])
  @@map("eventos_processados")
}

/// Movimentação (histórico de entrada/saída/ajuste/transferência)
model Movimentacao {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  produtoId  String   @map("produto_id") @db.Uuid
  depositoId String   @map("deposito_id") @db.Uuid
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  tipo          TipoMovimentacao
  motivo        MotivoMovimentacao
  quantidade    Int // Positivo = entrada, Negativo = saída
  custoUnitario Decimal?           @map("custo_unitario") @db.Decimal(19, 2)
  observacao    String?
  usuarioId     String?            @map("usuario_id") @db.Uuid // Autor da movimentação (auditoria); nulo em movimentações originadas por evento

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([tenantId])
  @@index([tenantId, produtoId])
  @@index([depositoId])
  @@index([criadoEm])
  @@index([tipo])
  @@map("movimentacoes")
}

// ─── Compras (suprimento) ─────────────────────────────────────

/// O pedido de compra vive no inventory porque o efeito físico do
/// RECEBIMENTO é a entrada no estoque: receber e movimentar acontecem
/// no mesmo banco (mesma razão do caixa morar junto do pagamento no
/// order-service). Fornecedor é referência por id+nome (mora no
/// customer-service; sem FK cross-service, padrão do projeto).
enum StatusCompra {
  RASCUNHO
  ENVIADO
  AGUARDANDO_RECEBIMENTO
  RECEBIDO_PARCIAL
  RECEBIDO
  CANCELADO
}

model PedidoCompra {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Sequencial por tenant, formatado na exibição (ex: "000012").
  numero         Int
  fornecedorId   String? @map("fornecedor_id") @db.Uuid
  fornecedorNome String  @map("fornecedor_nome")

  status StatusCompra @default(RASCUNHO)

  // Totais (dinheiro SEMPRE Decimal)
  valorProdutos Decimal @default(0) @map("valor_produtos") @db.Decimal(12, 2)
  valorFrete    Decimal @default(0) @map("valor_frete") @db.Decimal(12, 2)
  valorImpostos Decimal @default(0) @map("valor_impostos") @db.Decimal(12, 2)
  valorTotal    Decimal @default(0) @map("valor_total") @db.Decimal(12, 2)

  dataEmissao         DateTime  @default(now()) @map("data_emissao")
  dataPrevistaEntrega DateTime? @map("data_prevista_entrega")
  dataRecebimento     DateTime? @map("data_recebimento")

  // NF-e de origem (importação): chave única por tenant deduplica reimportação.
  nfeNumero String? @map("nfe_numero")
  nfeSerie  String? @map("nfe_serie")
  nfeChave  String? @map("nfe_chave")

  condicaoPagamento String? @map("condicao_pagamento")
  formaPagamento    String? @map("forma_pagamento")
  observacoes       String? @db.Text

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  itens ItemPedidoCompra[]

  @@unique([tenantId, numero])
  @@unique([tenantId, nfeChave])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, fornecedorId])
  @@map("pedidos_compra")
}

model ItemPedidoCompra {
  id             String       @id @default(uuid()) @db.Uuid
  pedidoCompraId String       @map("pedido_compra_id") @db.Uuid
  pedidoCompra   PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)

  /// Nulo quando o item veio de NF-e e o produto ainda não existe no
  /// catálogo (v1 não cria produto automaticamente; casa por SKU quando dá).
  produtoId   String? @map("produto_id") @db.Uuid
  produtoNome String  @map("produto_nome")
  sku         String
  ncm         String?
  cfop        String?
  unidade     String  @default("UN")

  quantidade         Decimal @db.Decimal(12, 3)
  quantidadeRecebida Decimal @default(0) @map("quantidade_recebida") @db.Decimal(12, 3)

  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 4)
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)
  valorIcms     Decimal @default(0) @map("valor_icms") @db.Decimal(12, 2)
  valorIpi      Decimal @default(0) @map("valor_ipi") @db.Decimal(12, 2)
  valorPis      Decimal @default(0) @map("valor_pis") @db.Decimal(12, 2)
  valorCofins   Decimal @default(0) @map("valor_cofins") @db.Decimal(12, 2)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([pedidoCompraId])
  @@index([produtoId])
  @@map("itens_pedidos_compra")
}
