// ═══════════════════════════════════════════════════════════════
// iMestreDigital - Schema do Order Service (OMS)
// ═══════════════════════════════════════════════════════════════
// Gerencia pedidos omnichannel (marketplace, e-commerce, loja física)
// com integração com inventory-service, fiscal-service e payment-service.
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enumerações ──────────────────────────────────────────────

enum StatusPedido {
  RASCUNHO
  PENDENTE
  CONFIRMADO
  EM_SEPARACAO
  FATURADO
  ENVIADO
  ENTREGUE
  CANCELADO
  DEVOLVIDO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  PARCIAL
  REEMBOLSADO
  CANCELADO
}

enum OrigemPedido {
  LOJA_FISICA
  ECOMMERCE
  MARKETPLACE
  TELEFONE
  WHATSAPP
  MANUAL
  OUTRO
}

enum MetodoPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
}

enum StatusDevolucao {
  SOLICITADA
  APROVADA
  RECEBIDA
  REEMBOLSADA
  REJEITADA
}

enum MotivoDevolucao {
  DEFEITO
  ARREPENDIMENTO
  TROCA
  PRODUTO_ERRADO
  OUTRO
}

// ─── Pedido (Ordem de Venda) ─────────────────────────────────

/// Pedido completo com informações de cliente, itens, pagamento e entrega.
/// Suporta múltiplos canais: marketplace, e-commerce, loja física, manual.
model Pedido {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Numeração
  numero Int @map("numero")

  // Cliente
  clienteId      String? @map("cliente_id") @db.Uuid
  clienteNome    String  @map("cliente_nome")
  clienteEmail   String? @map("cliente_email")
  clienteCpfCnpj String? @map("cliente_cpf_cnpj")

  // Origem e Canal
  origem          OrigemPedido @default(LOJA_FISICA) @map("origem")
  canalOrigem     String?      @map("canal_origem") // MERCADOLIVRE, SHOPEE, AMAZON, MAGALU, SITE, LOJA_FISICA, MANUAL
  pedidoExternoId String?      @unique @map("pedido_externo_id") // ID do marketplace

  // Status do Pedido
  status StatusPedido @default(RASCUNHO) @map("status")

  // Status do Pagamento
  statusPagamento StatusPagamento @default(PENDENTE) @map("status_pagamento")

  // Pagamento
  metodoPagamento MetodoPagamento? @map("metodo_pagamento")
  parcelas        Int              @default(1)

  // Valores (using correct precision)
  valorProdutos Decimal @default(0) @map("valor_produtos") @db.Decimal(19, 2)
  valorDesconto Decimal @default(0) @map("valor_desconto") @db.Decimal(19, 2)
  valorFrete    Decimal @default(0) @map("valor_frete") @db.Decimal(19, 2)
  valorTotal    Decimal @default(0) @map("valor_total") @db.Decimal(19, 2)

  // Observações
  observacao String? @map("observacao")

  // Endereço de Entrega (JSON com: cep, rua, numero, complemento, bairro, cidade, uf)
  enderecoEntrega Json? @map("endereco_entrega")

  // Rastreamento
  rastreamento   String? @map("rastreamento")
  codigoRastreio String? @map("codigo_rastreio")
  transportadora String? @map("transportadora")
  prazoEntrega   Int?    @map("prazo_entrega") // dias

  // Datas de Transição de Status
  dataAprovacao    DateTime? @map("data_aprovacao")
  dataSeparacao    DateTime? @map("data_separacao")
  dataFaturamento  DateTime? @map("data_faturamento")
  dataEnvio        DateTime? @map("data_envio")
  dataEntrega      DateTime? @map("data_entrega")
  dataCancelamento DateTime? @map("data_cancelamento")

  // Cancelamento
  motivoCancelamento String? @map("motivo_cancelamento")

  // Nota Fiscal
  notaFiscalId String? @map("nota_fiscal_id") @db.Uuid

  // Timestamps
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos
  itens      ItemPedido[]
  historico  HistoricoPedido[]
  pagamentos Pagamento[]
  devolucoes Devolucao[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([status])
  @@index([statusPagamento])
  @@index([canalOrigem])
  @@index([clienteId])
  @@index([criadoEm])
  @@index([dataAprovacao])
  @@index([dataEnvio])
  @@index([dataEntrega])
  @@map("pedidos")
}

// ─── Item do Pedido ──────────────────────────────────────────

/// Itens (produtos) que fazem parte do pedido.
model ItemPedido {
  id       String @id @default(uuid()) @db.Uuid
  pedidoId String @map("pedido_id") @db.Uuid
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  produtoId  String  @map("produto_id") @db.Uuid
  variacaoId String? @map("variacao_id") @db.Uuid

  sku        String @map("sku")
  titulo     String @map("titulo")
  quantidade Int    @map("quantidade")

  // Preços
  valorUnitario Decimal  @map("valor_unitario") @db.Decimal(19, 2)
  valorDesconto Decimal  @default(0) @map("valor_desconto") @db.Decimal(19, 2)
  valorTotal    Decimal  @map("valor_total") @db.Decimal(19, 2)
  precoCusto    Decimal? @map("preco_custo") @db.Decimal(19, 2)

  // Dimensões
  peso        Decimal? @map("peso") @db.Decimal(10, 3)
  largura     Decimal? @map("largura") @db.Decimal(10, 2)
  altura      Decimal? @map("altura") @db.Decimal(10, 2)
  comprimento Decimal? @map("comprimento") @db.Decimal(10, 2)

  criadoEm DateTime @default(now()) @map("criado_em")

  // Relacionamentos
  itensDevolvidos ItemDevolucao[]

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedidos")
}

// ─── Histórico de Pedido ────────────────────────────────────

/// Rastreamento de todas as mudanças de status do pedido.
model HistoricoPedido {
  id       String @id @default(uuid()) @db.Uuid
  pedidoId String @map("pedido_id") @db.Uuid
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id") @db.Uuid

  statusAnterior String? @map("status_anterior")
  statusNovo     String  @map("status_novo")
  descricao      String  @map("descricao")

  usuarioId   String? @map("usuario_id") @db.Uuid
  dadosExtras Json?   @map("dados_extras")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([pedidoId])
  @@index([tenantId])
  @@index([criadoEm])
  @@map("historicos_pedidos")
}

// ─── Idempotência de Consumo Kafka ───────────────────────────

/// Registro de eventos já processados (idempotência do consumo Kafka).
/// Garante que o mesmo evento (ex. estoque.reservado para um pedidoId) só
/// produza efeito colateral uma única vez, mesmo com reentrega do broker.
/// Espelha o modelo homônimo do inventory-service (mesmo contrato de saga).
model EventoProcessado {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  /// Nome lógico do evento consumido (ex. "estoque.reservado", "estoque.insuficiente").
  evento       String
  /// Identificador do agregado de referência (ex. pedidoId).
  referenciaId String @map("referencia_id")

  processadoEm DateTime @default(now()) @map("processado_em")

  @@unique([evento, referenciaId], name: "evento_referenciaId")
  @@index([tenantId])
  @@map("eventos_processados")
}

// ─── Pagamento ───────────────────────────────────────────────

/// Informações de pagamento vinculadas ao pedido.
enum TipoPagamento {
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  PIX
  TRANSFERENCIA
  MARKETPLACE
  DINHEIRO
}

enum StatusPagamentoDetalhado {
  PENDENTE
  PROCESSANDO
  APROVADO
  RECUSADO
  ESTORNADO
}

model Pagamento {
  id       String @id @default(uuid()) @db.Uuid
  pedidoId String @map("pedido_id") @db.Uuid
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id") @db.Uuid

  // Tipo e Status
  tipo   TipoPagamento            @map("tipo")
  status StatusPagamentoDetalhado @default(PENDENTE) @map("status")

  valor    Decimal @db.Decimal(19, 2)
  parcelas Int     @default(1)

  // Gateway de Pagamento
  gateway            String? @map("gateway")
  transacaoExternaId String? @map("transacao_externa_id")
  dadosGateway       Json?   @map("dados_gateway")

  dataPagamento DateTime? @map("data_pagamento")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([pedidoId])
  @@index([tenantId])
  @@index([status])
  @@map("pagamentos")
}

// ─── Devolução ───────────────────────────────────────────────

/// Gestão de devoluções e reembolsos.
model Devolucao {
  id       String @id @default(uuid()) @db.Uuid
  pedidoId String @map("pedido_id") @db.Uuid
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id") @db.Uuid

  motivo MotivoDevolucao @map("motivo")
  status StatusDevolucao @default(SOLICITADA) @map("status")

  valorReembolso Decimal @map("valor_reembolso") @db.Decimal(19, 2)

  codigoRastreioRetorno String? @map("codigo_rastreio_retorno")

  observacao String? @map("observacao")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos
  itens ItemDevolucao[]

  @@index([pedidoId])
  @@index([tenantId])
  @@index([status])
  @@map("devolucoes")
}

// ─── Item de Devolução ───────────────────────────────────────

/// Itens específicos que fazem parte da devolução.
model ItemDevolucao {
  id          String    @id @default(uuid()) @db.Uuid
  devolucaoId String    @map("devolucao_id") @db.Uuid
  devolucao   Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)

  itemPedidoId String     @map("item_pedido_id") @db.Uuid
  itemPedido   ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)

  quantidade Int             @map("quantidade")
  motivo     MotivoDevolucao @map("motivo")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([devolucaoId])
  @@index([itemPedidoId])
  @@map("itens_devolucoes")
}

// ─── Forma de Pagamento (cadastro por tenant) ─────────────────

/// Catálogo de formas de pagamento usadas na venda/recebimento
/// (ex: "Amex Crédito 2x", "PIX", "Dinheiro"). Cartões carregam
/// bandeira + parcelas; taxas/prazo alimentam a conciliação futura.
model FormaPagamento {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  descricao String // ex: "Amex Crédito 2x"
  /// DINHEIRO | PIX | CARTAO_CREDITO | CARTAO_DEBITO | BOLETO | TRANSFERENCIA | OUTRO
  tipo      String
  /// Bandeira do cartão (Visa, Mastercard, Amex, Elo...) — só para cartões.
  bandeira  String?
  /// Número de parcelas desta forma (1 = à vista).
  parcelas  Int     @default(1)

  /// Taxa percentual da operadora (ex: 4.92) — opcional.
  taxaPct              Decimal? @map("taxa_pct") @db.Decimal(6, 3)
  /// Taxa fixa em R$ por transação — opcional.
  taxaFixa             Decimal? @map("taxa_fixa") @db.Decimal(10, 2)
  /// Prazo (dias) para o valor cair na conta — opcional.
  prazoRecebimentoDias Int?     @map("prazo_recebimento_dias")

  ativa Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([tenantId, descricao])
  @@index([tenantId])
  @@index([tenantId, tipo])
  @@map("formas_pagamento")
}

// ─── Caixa (sessão de PDV / balcão) ───────────────────────────
//
// O Caixa vive no order-service (e não no financial-service) porque a sessão
// pertence ao domínio de venda/PDV e o pagamento (modelo Pagamento, acima)
// precisa virar movimentação de caixa na MESMA transação e no MESMO banco.
// No financial-service o vínculo dependeria de evento assíncrono e o caixa
// poderia divergir da venda.

enum StatusSessaoCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentacaoCaixa {
  ENTRADA
  SAIDA
}

enum CategoriaMovimentacaoCaixa {
  VENDA
  SUPRIMENTO
  SANGRIA
  DESPESA
  REEMBOLSO
  OUTROS
}

/// Turno de caixa de um terminal. Regra: no máximo UMA sessão ABERTO por tenant.
model SessaoCaixa {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Numeração legível por tenant/ano: "CAIXA-2026-003".
  numero String
  status StatusSessaoCaixa @default(ABERTO)

  /// Terminal ("Caixa 01"). Hoje é string livre — não há cadastro de terminais.
  caixa String

  /// Nome do operador do turno (o front envia texto livre).
  operador   String
  /// Usuário do JWT que abriu o turno, quando disponível.
  operadorId String? @map("operador_id") @db.Uuid

  aberturaEm          DateTime @default(now()) @map("abertura_em")
  valorAbertura       Decimal  @map("valor_abertura") @db.Decimal(12, 2)
  observacoesAbertura String?  @map("observacoes_abertura") @db.Text

  fechamentoEm          DateTime? @map("fechamento_em")
  valorContado          Decimal?  @map("valor_contado") @db.Decimal(12, 2)
  /// Snapshot do saldo esperado no instante do fechamento (auditoria).
  valorEsperado         Decimal?  @map("valor_esperado") @db.Decimal(12, 2)
  /// valorContado - valorEsperado. > 0 sobra, < 0 falta.
  diferenca             Decimal?  @db.Decimal(12, 2)
  observacoesFechamento String?   @map("observacoes_fechamento") @db.Text

  /// Trava de unicidade REAL de "1 caixa aberto por tenant", garantida pelo banco:
  /// recebe o tenantId enquanto a sessão está ABERTO e volta a NULL no fechamento.
  /// No Postgres NULLs são distintos entre si num índice único, então N sessões
  /// FECHADO convivem, mas uma segunda ABERTO do mesmo tenant viola o unique (P2002).
  /// Sem isso, duas aberturas simultâneas passariam pelo check da aplicação.
  travaCaixaAberto String? @unique @map("trava_caixa_aberto") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  movimentacoes MovimentacaoCaixa[]

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([tenantId, aberturaEm])
  @@map("sessoes_caixa")
}

/// Lançamento de caixa. `valor` é SEMPRE positivo — o sinal vem de `tipo`.
model MovimentacaoCaixa {
  id       String      @id @default(uuid()) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  sessaoId String      @map("sessao_id") @db.Uuid
  sessao   SessaoCaixa @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  tipo      TipoMovimentacaoCaixa
  categoria CategoriaMovimentacaoCaixa
  descricao String                     @db.Text
  valor     Decimal                    @db.Decimal(12, 2)

  /// Forma usada (reaproveita o enum de Pagamento) — base dos totais por forma.
  formaPagamento TipoPagamento? @map("forma_pagamento")

  pedidoId     String? @map("pedido_id") @db.Uuid
  pedidoNumero String? @map("pedido_numero")
  /// Vínculo com o Pagamento que originou o lançamento (VENDA e o REEMBOLSO do
  /// respectivo estorno). A idempotência é o unique COMPOSTO [pagamentoId,
  /// categoria], e não o pagamentoId sozinho: um mesmo pagamento produz até
  /// duas movimentações — a VENDA e, se estornado, o REEMBOLSO. Cada uma delas
  /// continua única (retry/reprocessamento não duplica).
  pagamentoId  String? @map("pagamento_id") @db.Uuid

  operador String

  criadoEm DateTime @default(now()) @map("criado_em")

  /// NULLs são distintos entre si no Postgres: movimentações manuais (sem
  /// pagamentoId) não disputam esta trava.
  @@unique([pagamentoId, categoria])
  @@index([tenantId, sessaoId, criadoEm])
  @@map("movimentacoes_caixa")
}
