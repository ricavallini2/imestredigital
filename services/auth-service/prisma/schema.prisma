// ═══════════════════════════════════════════════════════════════
// iMestreDigital - Schema do Auth Service
// ═══════════════════════════════════════════════════════════════
// Gerencia tenants (empresas), usuários, tokens e permissões.
// Este é o schema mais crítico do sistema — todas as outras
// tabelas em outros serviços referenciam o tenantId daqui.
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────

/// Cargo define o TEMPLATE inicial de permissões do usuário.
/// As permissões efetivas ficam em PermissaoUsuario e podem ser
/// ajustadas individualmente por admin/gerente.
enum CargoUsuario {
  ADMIN
  GERENTE
  VENDEDOR
  CAIXA
  ESTOQUISTA
  FINANCEIRO
  FUNCIONARIO
  OPERADOR // legado: equivalente a VENDEDOR (mantido p/ usuários já criados)
  VISUALIZADOR
}

enum StatusUsuario {
  ATIVO
  INATIVO
  BLOQUEADO
  PENDENTE
  REMOVIDO // Soft-delete: usuário removido do tenant, mantido para histórico
}

enum PlanoTenant {
  STARTER
  PROFISSIONAL
  ENTERPRISE
}

enum StatusTenant {
  ATIVO
  INATIVO
  SUSPENSO
  TRIAL
  CANCELADO // Assinatura cancelada pelo cliente ou por inadimplência
}

// ─── Tenant (Empresa) ─────────────────────────────────────

/// Empresa/organização cadastrada no sistema.
/// Cada tenant tem seus dados completamente isolados.
model Tenant {
  id                String   @id @default(uuid()) @db.Uuid
  nome              String
  cnpj              String?  @unique
  email             String
  telefone          String?
  endereco          String?
  inscricaoEstadual String?  @map("inscricao_estadual")

  // Plano e limites
  plano             PlanoTenant @default(STARTER)
  status            StatusTenant @default(ATIVO)
  limiteUsuarios    Int      @default(1) @map("limite_usuarios")
  limitePedidosMes  Int      @default(500) @map("limite_pedidos_mes")

  // Configurações do tenant (JSON flexível)
  configuracoes     Json?    @default("{}")

  // Timestamps
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos
  usuarios          Usuario[]

  @@index([status])
  @@map("tenants")
}

// ─── Usuário ──────────────────────────────────────────────

/// Usuário do sistema, sempre vinculado a um tenant.
model Usuario {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  nome            String
  email           String
  senhaHash       String    @map("senha_hash")

  // Permissões
  cargo           CargoUsuario @default(OPERADOR)
  status          StatusUsuario @default(ATIVO)
  // Pode autorizar vendas com desconto acima do teto configurado (além de GERENTE/ADMIN).
  podeLiberarVenda Boolean  @default(false) @map("pode_liberar_venda")

  // Verificação e segurança
  emailVerificado Boolean   @default(false) @map("email_verificado")
  ultimoLogin     DateTime? @map("ultimo_login")
  tentativasLogin Int       @default(0) @map("tentativas_login")
  bloqueadoAte    DateTime? @map("bloqueado_ate")

  // Avatar e preferências
  avatarUrl       String?   @map("avatar_url")
  preferencias    Json?     @default("{}")

  // Timestamps
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  // Relacionamentos
  refreshTokens   RefreshToken[]
  permissoes      PermissaoUsuario[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("usuarios")
}

// ─── Permissão por módulo ─────────────────────────────────

/// Permissão efetiva do usuário em um módulo do ERP.
/// Uma linha por usuário × módulo, com as 4 ações do CRUD.
/// O cargo apenas semeia estes valores na criação; a partir daí
/// admin/gerente ajustam individualmente.
model PermissaoUsuario {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Chave do módulo (ver MODULOS no código: produtos, clientes, caixa...)
  modulo       String

  visualizar   Boolean  @default(false)
  incluir      Boolean  @default(false)
  editar       Boolean  @default(false)
  excluir      Boolean  @default(false)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([usuarioId, modulo])
  @@index([usuarioId])
  @@map("permissoes_usuario")
}

// ─── Refresh Token ────────────────────────────────────────

/// Tokens de refresh armazenados para rotação segura.
/// Cada login gera um refresh token; ao renovar, o antigo é revogado.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  token       String    @unique
  usuarioId   String    @map("usuario_id") @db.Uuid
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  expiraEm    DateTime  @map("expira_em")
  revogado    Boolean   @default(false)
  revogadoEm  DateTime? @map("revogado_em")

  criadoEm    DateTime  @default(now()) @map("criado_em")

  @@index([usuarioId])
  @@index([token])
  @@index([expiraEm])
  @@map("refresh_tokens")
}
